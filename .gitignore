# Local experiments that are not part of the public application
/android-player/
/qwen_asr_worker.py
/requirements-local-asr.txt
/bin/feishu-audio-injector.*
/bin/setup-multi-output.swift
/bin/microphone-probe*
/bin/screen-audio-probe.swift

# Dependencies, generated bundles, native binaries and tooling caches
/node_modules/
/.venv*/
/models/
**/__pycache__/
*.py[cod]
/.playwright-cli/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.vscode/
/.idea/
/.DS_Store
/bin/*
!/bin/*.swift
!/bin/*.py
!/bin/*.sh
/web/app.bundle.*

# Keep these exclusions after the native-source allow rules above.
/bin/feishu-audio-injector.*
/bin/setup-multi-output.swift
/bin/microphone-probe*
/bin/screen-audio-probe.swift
