!/.env.example
/secrets/
*.key
*.pem
*.p12
*.pfx
*credentials*.json
*secret*.json
/huoshan_config.json
/voidce_key.txt

# User materials, recordings, conversations, exports and diagnostics
/materials/
/private/
/var/
/output/
*.wav
*.mp3
*.m4a
*.flac
*.pcm
*.mp4
*.mov
*.png
*.jpg
*.jpeg
*.webp
*.pdf
*.docx
*.xlsx
*.csv
*.zip
*.tar.gz
*.jsonl
